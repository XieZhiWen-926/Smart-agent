# ==============================================
# 智扫通智能客服 v2 - 环境变量模板
# ------------------------------------------------------------
# 使用方法：复制本文件为 .env，填入真实值
#   cp .env.example .env
#
# 注意：
#   - .env 里放的是密码和 API Key，千万不要提交到 Git！
#   - 下面示例中的 key/密码均为占位演示，请务必替换成自己的。
#   - docker compose 部署时 MYSQL_HOST/REDIS_HOST 已由
#     docker-compose.yml 直接指定为服务名 mysql / redis，
#     本文件里的 127.0.0.1 只在"本机手动跑后端"时生效。
# ==============================================

# ------------------------------------------------------------
# 【重要】Docker 镜像加速前缀
# ------------------------------------------------------------
# 国内直连 Docker Hub 拉镜像会超时。留空 = 用官方镜像；
# 填上加速源前缀 = 所有基础镜像都从国内拉。
#
# 推荐先运行 deploy/docker/setup-docker-mirror.ps1 配置引擎级加速
# （这是根治办法，所有镜像都受益）。若因为权限/公司网络无法改引擎，
# 再把下面这行打开作为"项目级"兜底方案：
#
# DOCKER_MIRROR=docker.m.daocloud.io/library/
#
# 备选加速源（可换着试，哪个快用哪个）：
#   docker.m.daocloud.io/library/
#   docker.1ms.run/library/
#   docker.xuanyuan.me/library/
DOCKER_MIRROR=

# ---------- 数据库 MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123456
MYSQL_DATABASE=smart_agent_v2
# 异步驱动连接串（aiomysql），程序内部自动拼接，无需手动填
# 格式：mysql+aiomysql://user:pass@host:port/db?charset=utf8mb4

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 大模型（阿里通义千问 DashScope）----------
# 【必填】去阿里云百炼平台申请，没有它聊天功能不可用
# 申请地址：https://bailian.console.aliyun.com/  →  API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAT_MODEL_NAME=qwen3-max                # 对话模型
EMBEDDING_MODEL_NAME=text-embedding-v4   # 向量模型（RAG/记忆召回用）

# ---------- 高德地图 API ----------
# 查地址/天气/附近维修点用；注意申请"Web 服务"类型的 Key，不是 JS API Key
AMAP_KEY=
# 高德安全密钥（2021年12月后申请的key需要配合 jscode 使用，服务端调用可选）
AMAP_SECURITY_CODE=

# ---------- 百度地图 API（可选，作为高德的备选） ----------
BAIDU_MAP_AK=
BAIDU_MAP_SK=

# ---------- JWT 鉴权 ----------
# 登录 token 的签名密钥。【生产环境必须改】成随机长字符串，
# 且所有后端实例要用同一个，否则互相不认对方签的 token
JWT_SECRET_KEY=please_change_this_to_a_random_secret_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440  # token 有效期（分钟），1440 = 1 天

# ---------- 应用 ----------
APP_HOST=0.0.0.0       # 0.0.0.0 表示监听所有网卡（容器内必须这么配）
APP_PORT=8000
APP_ENV=development    # development / production
LOG_LEVEL=INFO

# ---------- 向量库（RAG 知识库存在哪） ----------
CHROMA_PERSIST_DIR=./data/chroma_db  # 向量数据落盘目录
CHROMA_COLLECTION=agent_knowledge    # 集合名（相当于"一张向量表"）

# ---------- Celery ----------
# broker 是"任务队列"，backend 是"结果仓库"；用 Redis 的不同 db 编号隔开
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
